{
  "mcpServers": {
    "tools": {
      "command": "uvx",
      "args": [
        "subroutine~=0.9.0",
        "mcp",
        "--connection", "${user_config.connection}",
        "--workspace", "${user_config.workspace}"
      ],
      "env": {
        "SUBROUTINE_TOKEN": "${user_config.token}"
      }
    }
  }
}
